  <style>
    :root { --gap: 14px; --radius: 14px; }
    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Noto Sans, sans-serif;
      margin: 0;
      background: #ffe6f0; /* light pink */
      color: #0b0d10;
      line-height: 1.5;
    }
    header {
      position: sticky; top: 0; z-index: 10; background: #fff;
      border-bottom: 1px solid #e7e9ee; padding: 14px 16px; display: flex; align-items: center; gap: 8px;
    }
    header h1 { font-size: 18px; margin: 0; font-weight: 700; letter-spacing: .2px; }
    header .spacer { flex: 1 }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      border: 1px solid #d6dae3; padding: 14px 16px; background: #fff; border-radius: var(--radius);
      text-decoration: none; color: inherit; cursor: pointer; user-select: none;
      transition: transform .02s ease-in-out, background .15s ease-in-out;
    }
    .btn:active { transform: translateY(1px); }
    .btn.small { padding: 10px 12px; border-radius: 10px; }
    main { padding: 24px; max-width: 980px; margin: 24px auto; background: rgba(255,255,255,0.96); border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,.12); position: relative; z-index:1; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: var(--gap); }
    .card { background: #fff; border: 1px solid #e7e9ee; border-radius: var(--radius); padding: 14px; display: flex; flex-direction: column; gap: 8px; }
    .card h3 { margin: 0; font-size: 16px; }
    .muted { color: #5b6473; font-size: 13px; }
    .stack { display: flex; flex-direction: column; gap: var(--gap); }
    .row { display: flex; align-items: center; gap: var(--gap); flex-wrap: wrap; }
    .hidden { display: none !important; }
    .pill { display: inline-block; border: 1px solid #e7e9ee; background: #f8f9fb; border-radius: 999px; padding: 6px 10px; font-size: 12px; margin-right: 6px; margin-bottom: 6px; }
    footer { color: #6b7380; font-size: 12px; text-align: center; padding: 24px 16px 40px; }
  
    #collage{ position: fixed; inset: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0; padding: 0; pointer-events: none; z-index: -1; opacity: 0.8; overflow:hidden; }
    #collage .tile{ aspect-ratio: 1; background-size: cover; background-position: center; border-radius: 12px; box-shadow: 0 2px 6px rgba(0,0,0,.18); transform: rotate(var(--rot, 0deg)) scale(1.12); }
    main { padding: 24px; max-width: 980px; margin: 24px auto; background: rgba(255,255,255,0.96); border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,.12); position: relative; z-index:1; }

  
    
    
    

  
    #home-panel {
      background: #ffffff;
      border-radius: 24px;
      padding: 60px 48px;
      max-width: 900px;
      margin: 60px auto;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
      text-align: center;
      position: relative;
      z-index: 10;
      min-height: 66vh; /* 2/3 of viewport */
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    #home-panel h1 {
      margin-bottom: 40px;
      font-size: 3.2rem;
    }
    #home-panel .grid {
      justify-content: center;
      gap: 32px;
    }
    #home-panel .card {
      font-size: 1.5rem;
      padding: 28px;
      border-radius: 16px;
    }

  
    /* === OVERRIDES: make the home selection area big, centered, and above collage === */
    #homeView .card {
      background: #ffffff !important;
      border-radius: 24px !important;
      padding: 60px 48px !important;
      max-width: 900px;
      margin: 60px auto !important;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25) !important;
      position: relative;
      z-index: 20; /* ensure above collage */
      min-height: 66vh; /* roughly two-thirds screen */
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }
    #homeView h3 {
      font-size: 3rem !important;
      margin: 0 0 24px 0 !important;
    }
    #homeView .muted {
      font-size: 1.2rem !important;
      margin-bottom: 20px !important;
    }
    #homeView .grid {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)) !important;
      gap: 24px !important;
      justify-items: center;
    }
    #homeView .btn {
      font-size: 1.3rem !important;
      padding: 20px 24px !important;
      border-radius: 16px !important;
    }
    /* Collage stays below everything */
    #collage { z-index: -1 !important; }

  
    /* Hide meal pills/tabs and label */
    #mealView .row > div:first-child { display: none !important; }

    /* Enlarge recipe cards to occupy most of the page */
    #mealCards {
      display: grid !important;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)) !important;
      gap: 24px !important;
    }
    #mealCards .card {
      padding: 24px !important;
      border-radius: 18px !important;
      box-shadow: 0 6px 20px rgba(0,0,0,0.10);
    }
    #mealCards .card h3 {
      font-size: 1.6rem !important;
      margin-bottom: 8px !important;
    }
    #mealCards .card .muted {
      font-size: 1.05rem !important;
    }

  
    /* Home panel spacing polish */
    #homeView .card {
      gap: 20px !important;
    }
    #homeView .grid {
      gap: 28px !important;
    }

  
    /* Responsive recipe grid by screen width */
    #mealCards { 
      display: grid !important; 
      grid-template-columns: 1fr !important; 
      gap: 24px !important;
    }
    @media (min-width: 640px) {
      #mealCards { grid-template-columns: repeat(2, 1fr) !important; }
    }
    @media (min-width: 1024px) {
      #mealCards { grid-template-columns: repeat(3, 1fr) !important; }
    }
    @media (min-width: 1440px) {
      #mealCards { grid-template-columns: repeat(4, 1fr) !important; }
    }
