if (recipe.calories != null) macroParts.push(`${recipe.calories} kcal`);
if (recipe.protein != null) macroParts.push(`${recipe.protein} b`);
if (recipe.carbs != null) macroParts.push(`${recipe.carbs} w`);
if (recipe.fat != null) macroParts.push(`${recipe.fat} t`);
$("#macros").textContent = macroParts.join(" | ");
setView("detail");
