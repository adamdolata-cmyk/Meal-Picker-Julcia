        const card = document.createElement("div"); card.className = "card";
        const h = document.createElement("h3"); h.textContent = r.name; h.style.cursor = "pointer"; h.onclick = () => openDetail(r); card.appendChild(h);
        const m = document.createElement("div"); m.className = "muted";
        m.textContent = (r.time || ""); card.appendChild(m);
        wrap.appendChild(card);
      });
    }

    function openDetail(recipe) {
      state.currentRecipe = recipe;
      $("#title").textContent = recipe.name;
      $("#recipeName").textContent = recipe.name;
      const metaParts = [recipe.time || null, recipe.servings ? (recipe.servings + " servings") : null];
$("#meta").textContent = metaParts.filter(Boolean).join(" • ");
(recipe.tags || []).forEach(t => { const b = document.createElement("span"); b.className = "pill"; b.textContent = t; badges.appendChild(b); });
      const ing = $("#ingredients"); ing.innerHTML = ""; (recipe.ingredients || []).forEach(i => { const li = document.createElement("li"); li.textContent = i; ing.appendChild(li); });
      const steps = $("#steps"); steps.innerHTML = ""; (recipe.steps || []).forEach(s => { const li = document.createElement("li"); li.textContent = s; steps.appendChild(li); });
