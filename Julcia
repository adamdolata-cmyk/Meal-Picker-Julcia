    #mealCards .card h3 { font-size: clamp(1.2rem, 1.2rem + 0.2vw, 1.8rem) !important; }
    #mealCards .card .muted { font-size: clamp(1rem, 1rem + 0.15vw, 1.2rem) !important; }

  </style>
</head>
<body>
  <header>
    <button id="backBtn" class="btn small" aria-label="Back" onclick="goBack()">&larr;</button>
    <h1 id="title">MEAL PICKER DLA JULCI</h1>
    <div class="spacer"></div>
    <button class="btn small" onclick="showHome()">Home</button>
  </header>

  <main>
    <div id="collage" aria-hidden="true"></div>
    <!-- HOME -->
    <section id="homeView" class="stack">
      <div class="card">
        <h3>Pick a meal</h3>
        <div class="grid">
          <button class="btn" onclick="openMeal('Breakfast')">🥣 Breakfast</button>
          <button class="btn" onclick="openMeal('Lunch')">🥗 Lunch</button>
          <button class="btn" onclick="openMeal('Dinner')">🍽️ Dinner</button>
        </div>
      </div>
    </section>

    <!-- MEAL LIST -->
    <section id="mealView" class="hidden stack">
      <div class="row">
        <div>
          <div class="muted">Meal</div>
          <div id="mealPills"></div>
        </div>
      </div>
      <div id="mealCards" class="grid"></div>
    </section>

    <!-- RECIPE DETAIL -->
    <section id="detailView" class="hidden stack">
      <div class="card">
        <h3 id="recipeName">Recipe</h3>
        
        <p class="muted" id="meta"></p>
        <p class="muted" id="macros"></p>
        <div class="muted">Ingredients</div>
        <ul id="ingredients"></ul>
        <div class="muted">Steps</div>
        <ol id="steps"></ol>
        
      </div>
    </section>
  </main>

  

  <script>
    const $ = (q) => document.querySelector(q);
    const $$ = (q) => Array.from(document.querySelectorAll(q));

    const state = { view: 'home', currentMeal: null, currentRecipe: null };

    function setView(name) {
      state.view = name;
      $("#homeView").classList.toggle("hidden", name !== "home");
      $("#mealView").classList.toggle("hidden", name !== "meal");
      $("#detailView").classList.toggle("hidden", name !== "detail");
      $("#backBtn").classList.toggle("hidden", name === "home");
      if (name === "home") { $("#title").textContent = "MEAL PICKER DLA JULCI"; }
    }
    function goBack() { if (state.view === "detail") { openMeal(state.currentMeal); } else { showHome(); } }
    function showHome() { setView("home"); }

    function openMeal(meal) {
      state.currentMeal = meal;
      $("#title").textContent = meal;
      buildMealPills(meal);
      renderMealList();
      setView("meal");
    }
    function buildMealPills(meal) {
      const pills = $("#mealPills"); pills.innerHTML = "";
      ["Breakfast","Lunch","Dinner"].forEach(m => {
        const span = document.createElement("span");
        span.className = "pill" + (meal === m ? "": "");
        span.textContent = m; span.style.cursor = "pointer";
        span.onclick = () => openMeal(m);
        pills.appendChild(span);
      });
    }

    function renderMealList() {
      const wrap = $("#mealCards"); wrap.innerHTML = "";
      const items = recipes.filter(r => r.meal === state.currentMeal);
      if (!items.length) { wrap.innerHTML = '<div class="muted">No recipes yet.</div>'; return; }
