    // === Collage background on home screen ===
    const COLLAGE_IMG = "data:image/png;base64,";
    function buildCollage() {
      const c = document.querySelector('#collage');
      if (!c) return;
      c.innerHTML = "";
      const count = Math.max(120, Math.floor(window.innerWidth * window.innerHeight / 12000)); // scale with screen
      for (let i = 0; i < count; i++) {
        const d = document.createElement('div');
        d.className = 'tile';
        d.style.setProperty('--rot', (Math.random()*6-3).toFixed(1)+'deg');
        d.style.backgroundImage = `url(${COLLAGE_IMG})`;
        c.appendChild(d);
      }
    }
